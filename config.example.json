{
  "listen": "127.0.0.1:8080",
  "server_keys": ["change-this-local-key"],
  "zen_keys": ["sk-your-zen-key"],
  "go_keys": [],
  "anonymous": false,
  // enable_ipv6 samples pool_size source addresses from prefixes and rotates
  // the visible egress across them. ipv4_only instead runs one unbound lane
  // forced to IPv4 (tcp4): use it when the upstream answers 403 FreeTierError
  // to IPv6 traffic while accepting the same request over IPv4. It requires
  // enable_ipv6=false and ignores prefixes until rotation is re-enabled.
  "egress": {
    "enable_ipv6": true,
    "ipv4_only": false,
    "prefixes": ["2001:470:7331::/48", "2001:470:1f0b:cf4::/64"],
    "pool_size": 100
  },
  "upstream": {
    "zen": "https://opencode.ai/inference",
    "go": "https://opencode.ai/inference/go"
  },
  "retry": {
    "max_attempts": 3,
    "timeout_seconds": 300
  },
  "models": {
    "refresh_seconds": 300,
    "protocols": {}
  },
  "performance": {
    "max_idle_conns": 2048,
    "max_idle_conns_per_host": 256,
    "max_conns_per_host": 0,
    "idle_conn_timeout_seconds": 120,
    "connect_timeout_seconds": 5,
    "failure_cooldown_seconds": 15,
    "attempt_timeout_seconds": 0,
    "first_event_timeout_seconds": 0
  },
  "logging": {
    "level": "info",
    "ring_size": 2000,
    "dump_request_bodies": false
  },
  "webui": {
    "enabled": true,
    "listen": "0.0.0.0:8081",
    "username": "admin",
    "password": "change-this-admin-password",
    "session_ttl_minutes": 720
  },
  "prefer": "go",
  "reasoning": {
    "effort": "high",
    "effort_by_model": {}
  },
  "rotation": {
    "sota": { "alias": "sota", "order": [] },
    "sweet": { "alias": "sweet", "order": [] },
    "sota_size": 5,
    "first_output_seconds": 30
  }
}
